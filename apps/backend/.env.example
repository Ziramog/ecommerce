# ========================================================
# Mercadal Digital 360 — Backend Medusa 2 Environment Template
# ========================================================

# Database (PostgreSQL 16) — Staging VPS accessed via Tailscale or SSH tunnel
# [credencial: DATABASE_URL]
DATABASE_URL=
DATABASE_DRIVER_OPTIONS=

# Cache & Event Bus (Redis 7) — Staging VPS accessed via Tailscale or SSH tunnel
# [credencial: REDIS_URL]
REDIS_URL=

# Authentication Secrets
# [credencial: JWT_SECRET]
JWT_SECRET=
# [credencial: COOKIE_SECRET]
COOKIE_SECRET=

# CORS Configurations
STORE_CORS=
ADMIN_CORS=
AUTH_CORS=

# Server Configuration
PORT=9000
MEDUSA_BACKEND_URL=

# Runtime & Mode Configuration
MEDUSA_WORKER_MODE=
DISABLE_MEDUSA_ADMIN=

# Staging Flags (Must remain false or absent in production)
MEDUSA_STAGING_RELAX_COOKIES=
