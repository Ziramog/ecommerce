# ========================================================
# MERCADAL DIGITAL 360 — Staging Environment Template
# Archivo de referencia para ~/mercadal-staging/.env.staging
# NUNCA commitear credenciales reales. Permisos en VPS: chmod 600
# ========================================================

# Identificador de Namespace y Entorno
NODE_ENV=production
STAGING_BIND_IP=100.124.132.48

# --------------------------------------------------------
# PostgreSQL 16 (Contenedor mercadal-staging-postgres)
# Red interna aislada: mercadal_staging_net (sin puertos al host)
# --------------------------------------------------------
POSTGRES_DB=mercadal_staging_db
POSTGRES_USER=mercadal_staging_user
POSTGRES_PASSWORD=generate_high_entropy_secret_min_32_chars
DATABASE_URL=postgres://mercadal_staging_user:generate_high_entropy_secret_min_32_chars@postgres:5432/mercadal_staging_db

# --------------------------------------------------------
# Redis 7 (Contenedor mercadal-staging-redis)
# Red interna aislada: mercadal_staging_net (sin puertos al host)
# --------------------------------------------------------
REDIS_PASSWORD=generate_high_entropy_redis_secret_min_32_chars
REDIS_URL=redis://:generate_high_entropy_redis_secret_min_32_chars@redis:6379

# --------------------------------------------------------
# Medusa 2.21.2 Core Security Secrets
# Generar con: openssl rand -base64 32
# --------------------------------------------------------
JWT_SECRET=generate_high_entropy_jwt_secret_min_32_chars
COOKIE_SECRET=generate_high_entropy_cookie_secret_min_32_chars

# Worker Mode (server para instancia API única de staging)
MEDUSA_WORKER_MODE=server
LOG_LEVEL=info

# --------------------------------------------------------
# CORS & Red Tailscale (Sin acceso público)
# --------------------------------------------------------
# Permitir llamadas desde Storefronts locales y Tailscale
STORE_CORS=http://100.124.132.48:3000,http://100.124.132.48:3001,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
ADMIN_CORS=http://100.124.132.48:9000,http://localhost:9000,http://127.0.0.1:9000
AUTH_CORS=http://100.124.132.48:9000,http://localhost:9000,http://127.0.0.1:9000,http://100.124.132.48:3000,http://100.124.132.48:3001,http://localhost:3000,http://localhost:3001

# Habilitar Medusa Admin Dashboard en /app
DISABLE_MEDUSA_ADMIN=false

# --------------------------------------------------------
# Claves Publicables de Staging (Generadas por seed-staging.js)
# --------------------------------------------------------
STAGING_PK_B2C=pk_pampa_novus_b2c_staging_placeholder
STAGING_PK_B2B=pk_talabarteria_b2b_staging_placeholder

# --------------------------------------------------------
# Mercado Pago Sandbox (Credenciales de Prueba Aisladas)
# NUNCA ingresar credenciales de producción (PROD_*)
# --------------------------------------------------------
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_WEBHOOK_SECRET=mp_sandbox_webhook_secret_staging_test
MP_COLLECTOR_ID=000000000

# --------------------------------------------------------
# Guardas de Semillado Seguro (Pre-flight Fail-Closed)
# --------------------------------------------------------
MERCADAL_SEED_ENV=staging
ALLOW_DESTRUCTIVE_SEED=false
