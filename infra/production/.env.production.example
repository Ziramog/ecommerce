# ========================================================
# Mercadal Digital 360 — Production Environment Template
# Namespace: mercadal-prod
# CERO SECRETOS REALES EN ESTE ARCHIVO
# ========================================================

NODE_ENV=production

# --------------------------------------------------------
# 1. Base de Datos PostgreSQL (Contenedor mercadal-prod-postgres)
# --------------------------------------------------------
POSTGRES_DB=mercadal_prod_db
POSTGRES_USER=mercadal_prod_user
POSTGRES_PASSWORD=generate_strong_random_password_here
DATABASE_URL=postgres://mercadal_prod_user:generate_strong_random_password_here@postgres:5432/mercadal_prod_db

# --------------------------------------------------------
# 2. Redis 7 (Contenedor mercadal-prod-redis)
# --------------------------------------------------------
REDIS_PASSWORD=generate_strong_redis_password_here
REDIS_URL=redis://:generate_strong_redis_password_here@redis:6379

# --------------------------------------------------------
# 3. Medusa 2 Core Security & Secrets
# --------------------------------------------------------
JWT_SECRET=generate_64_character_random_hex_string_here
COOKIE_SECRET=generate_64_character_random_hex_string_here

# Modo de proceso (shared para nodo único con bajo consumo)
MEDUSA_WORKER_MODE=shared

# --------------------------------------------------------
# 4. Configuración CORS de Producción
# --------------------------------------------------------
STORE_CORS=https://pampanovus.com.ar,https://www.pampanovus.com.ar,https://mayorista.talabarteriamercadal.com.ar
ADMIN_CORS=https://admin.mercadal.com.ar
AUTH_CORS=https://pampanovus.com.ar,https://www.pampanovus.com.ar,https://mayorista.talabarteriamercadal.com.ar,https://admin.mercadal.com.ar

# --------------------------------------------------------
# 5. URLs y Publishable Keys
# --------------------------------------------------------
PROD_API_URL=https://api.mercadal.com.ar
PROD_PK_B2C=pk_prod_pampa_novus_b2c_here
PROD_PK_B2B=pk_prod_talabarteria_b2b_here

# --------------------------------------------------------
# 6. Integraciones Argentina (Pendientes de Activación Formal)
# --------------------------------------------------------
# Mercado Pago Producción
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# Andreani Logística Producción
ANDREANI_API_KEY=
ANDREANI_CONTRATO=
ANDREANI_CLIENTE=

# ARCA Facturación Electrónica (Ruta a certificados en host montados)
ARCA_CUIT=30582914725
ARCA_CERT_PATH=/etc/mercadal/certs/arca_prod.crt
ARCA_KEY_PATH=/etc/mercadal/certs/arca_prod.key
ARCA_PUNTO_VENTA=1

# Mercado Libre Producción
MELI_APP_ID=
MELI_CLIENT_SECRET=
MELI_REFRESH_TOKEN=
